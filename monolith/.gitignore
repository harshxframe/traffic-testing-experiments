# Dependency directories (never commit these)
node_modules/
jspm_packages/
web_modules/

# Local environment files (contains api keys and secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Build and production outputs
dist/
build/
.next/
out/
.nuxt/

# TypeScript cache
*.tsbuildinfo

# IDE and system files (Optional but recommended)
.vscode/
.idea/
.DS_Store
Thumbs.db
